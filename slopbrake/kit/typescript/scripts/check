#!/usr/bin/env bash
# The umbrella gate: agents, git hooks and CI all run this one command.
#   scripts/check            everything (pre-push, CI, implement-ticket step 3)
#   scripts/check --fast     everything but mutation (pre-commit, Stop hook)
#   scripts/check <stage>    one or more named stages
# Stage commands are this repo's own; edit them here. Raise the floor in
# stryker.config.json ("thresholds.break") via /retro.
set -uo pipefail
cd "$(dirname "$0")/.."
G=scripts/slopbrake
source "$G/run-stages.sh"
PM="@PM@"

STAGES=(lint types boundaries tests smoke test-quality mutation pr)
SLOW_STAGES=(mutation)

# Tools run from node_modules/.bin, never `$PM exec`: npm eats the tool's flags and installs
# whatever registry package matches a missing name.
tool() { # tool <bin> <package> [args...]
  local bin=$1 pkg=$2; shift 2
  if [ ! -x "node_modules/.bin/$bin" ]; then echo "$bin is not installed: $PM add -D $pkg" >&2; return 1; fi
  "node_modules/.bin/$bin" "$@"
}
has_script() { python3 -c 'import json, sys; sys.exit(not json.load(open("package.json")).get("scripts", {}).get(sys.argv[1]))' "$1" 2>/dev/null; }

stage_lint()         { $PM run -s lint; }
stage_types() {
  if ! has_script typecheck; then echo 'types: skipped: no "typecheck" script in package.json (e.g. "tsc --noEmit")'; return 78; fi
  $PM run -s typecheck
}
stage_boundaries() {
  # Without typescript, dependency-cruiser cannot read .ts files and passes on nothing.
  if [ -x node_modules/.bin/depcruise ] && [ ! -f node_modules/typescript/package.json ]; then
    echo "typescript is not installed: $PM add -D typescript" >&2; return 1
  fi
  tool depcruise dependency-cruiser @DEPCRUISE_PATHS@ --config .dependency-cruiser.cjs
}
stage_tests()        { $PM run -s test; }
stage_smoke() {
  if [ -f scripts/smoke.sh ]; then bash scripts/smoke.sh
  elif has_script smoke; then $PM run -s smoke
  else echo "smoke: skipped: no scripts/smoke.sh or package.json \"smoke\" script (run the real entry point end to end)"; return 78; fi
}
stage_test_quality() { tool eslint eslint --max-warnings 0 --no-error-on-unmatched-pattern @TEST_GLOBS@; }
stage_mutation() {
  local ranges status
  ranges=$(python3 "$G/changed_ranges.py" @MUTATE_INCLUDE@ \
    --exclude '**/*.test.*' --exclude '**/*.spec.*' --exclude '**/*.d.ts' --exclude '**/__tests__/**')
  status=$?
  if [ $status -eq 78 ]; then echo "${ranges:-mutation: skipped: no base to compare against}"; return 78; fi
  [ $status -eq 0 ] || return 1
  if [ -z "$ranges" ]; then echo "mutation: skipped: no changed source lines since the base"; return 78; fi
  tool stryker "@stryker-mutator/core @stryker-mutator/vitest-runner" run stryker.config.json --mutate "$ranges"
}
stage_pr()           { python3 "$G/pr_body_check.py"; }

run_stages "$@"
