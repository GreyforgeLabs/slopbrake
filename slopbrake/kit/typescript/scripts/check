#!/usr/bin/env bash
# The umbrella gate: agents, git hooks and CI all run this one command.
#   scripts/check            everything (pre-push, CI, implement-ticket step 3)
#   scripts/check --fast     everything but mutation (pre-commit, Stop hook)
#   scripts/check <stage>    one or more named stages
# Stage commands are this repo's own; edit them here. Raise the floor in
# stryker.config.json ("thresholds.break") via /retro.
set -uo pipefail
cd "$(dirname "$0")/.."
G=scripts/slopbrake
source "$G/run-stages.sh"
PM="@PM@"

STAGES=(lint types boundaries tests smoke test-quality mutation pr)
SLOW_STAGES=(mutation)

# Tools run from node_modules/.bin, never `$PM exec`: npm eats the tool's flags and installs
# whatever registry package matches a missing name.
tool() { # tool <bin> <package> [args...]
  local bin=$1 pkg=$2; shift 2
  if [ ! -x "node_modules/.bin/$bin" ]; then
    echo "$bin is not installed: $PM add -D $pkg" >&2
    if [ -f .pnp.cjs ]; then echo "  (Yarn Plug'n'Play has no node_modules/.bin: set 'nodeLinker: node-modules' in .yarnrc.yml)" >&2; fi
    return 1
  fi
  "node_modules/.bin/$bin" "$@"
}
# has_script <name>: 0 defined, 3 not defined, 1 (with the reason) when package.json is missing or broken.
has_script() {
  python3 -c 'import json, sys
try: scripts = json.load(open("package.json")).get("scripts") or {}
except (OSError, ValueError) as e: sys.exit(f"package.json: {e}")
sys.exit(0 if scripts.get(sys.argv[1]) else 3)' "$1"
}
# The typescript dependency-cruiser can load, for remedies: "typescript@<range>" from its meta.cjs.
ts_pkg() {
  python3 -c 'import re; print(repr("typescript@" + re.search(r"\btypescript: *\"([^\"]+)\"", open("node_modules/dependency-cruiser/src/meta.cjs").read())[1]))' 2>/dev/null || echo typescript
}

stage_lint()         { $PM run -s lint; }
stage_types() {
  has_script typecheck
  case $? in
    0) $PM run -s typecheck ;;
    3) echo 'types: skipped: no "typecheck" script in package.json (e.g. "tsc --noEmit")'; return 78 ;;
    *) return 1 ;;
  esac
}
stage_boundaries() {
  # dependency-cruiser exits 0 having read no .ts file when typescript is missing or newer than it supports.
  local out status
  if [ -x node_modules/.bin/depcruise ] && [ ! -f node_modules/typescript/package.json ]; then
    echo "typescript is not installed: $PM add -D $(ts_pkg)" >&2; return 1
  fi
  out=$(tool depcruise dependency-cruiser @DEPCRUISE_PATHS@ --config .dependency-cruiser.cjs 2>&1)
  status=$?
  [ -z "$out" ] || printf '%s\n' "$out"
  [ $status -eq 0 ] || return $status
  if grep -q missing-typescript-transpiler <<<"$out"; then
    echo "dependency-cruiser cannot load the installed typescript: $PM add -D $(ts_pkg)" >&2; return 1
  fi
  if grep -Eq '(^|[^0-9])0 modules' <<<"$out"; then
    echo "boundaries: dependency-cruiser cruised 0 modules under @DEPCRUISE_PATHS@, so nothing was checked" >&2; return 1
  fi
}
stage_tests()        { $PM run -s test; }
stage_smoke() {
  if [ -f scripts/smoke.sh ]; then bash scripts/smoke.sh; return; fi
  has_script smoke
  case $? in
    0) $PM run -s smoke ;;
    3) echo "smoke: skipped: no scripts/smoke.sh or package.json \"smoke\" script (run the real entry point end to end)"; return 78 ;;
    *) return 1 ;;
  esac
}
stage_test_quality() { tool eslint eslint --max-warnings 0 --no-error-on-unmatched-pattern @TEST_GLOBS@; }
stage_mutation() {
  local ranges status
  ranges=$(python3 "$G/changed_ranges.py" @MUTATE_INCLUDE@ \
    --exclude '**/*.test.*' --exclude '**/*.spec.*' --exclude '**/*.d.ts' --exclude '**/__tests__/**')
  status=$?
  if [ $status -eq 78 ]; then echo "${ranges:-mutation: skipped: no base to compare against}"; return 78; fi
  [ $status -eq 0 ] || return 1
  if [ -z "$ranges" ]; then echo "mutation: skipped: no changed source lines since the base"; return 78; fi
  tool stryker "@stryker-mutator/core @stryker-mutator/vitest-runner" run stryker.config.json --mutate "$ranges"
}
stage_pr()           { python3 "$G/pr_body_check.py"; }

run_stages "$@"
